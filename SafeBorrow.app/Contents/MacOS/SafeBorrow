#!/bin/bash
set -u

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
PYTHON="$ROOT/.venv/bin/python"
APP_FILE="$ROOT/safeborrow/data/app.py"
PORT=8501
URL="http://127.0.0.1:$PORT"
LOG_DIR="$HOME/Library/Logs/SafeBorrow"
LOG_FILE="$LOG_DIR/streamlit.log"

show_error() {
    /usr/bin/osascript -e "display dialog \"$1\" buttons {\"OK\"} default button \"OK\" with title \"SafeBorrow\""
}

if [ ! -x "$PYTHON" ]; then
    show_error "The project's .venv Python was not found. Create the environment and install requirements.txt first."
    exit 1
fi

mkdir -p "$LOG_DIR"

if /usr/sbin/lsof -nP -iTCP:$PORT -sTCP:LISTEN >/dev/null 2>&1; then
    if /usr/bin/curl -fsS "$URL/_stcore/health" >/dev/null 2>&1; then
        /usr/bin/open "$URL"
        exit 0
    fi
    show_error "Port $PORT is already being used by another app. Close that app and try SafeBorrow again."
    exit 1
fi

nohup "$PYTHON" -m streamlit run "$APP_FILE" \
    --server.address 127.0.0.1 \
    --server.port "$PORT" \
    --server.headless true \
    --browser.gatherUsageStats false \
    >>"$LOG_FILE" 2>&1 </dev/null &

for attempt in $(seq 1 30); do
    if /usr/bin/curl -fsS "$URL/_stcore/health" >/dev/null 2>&1; then
        /usr/bin/open "$URL"
        exit 0
    fi
    sleep 0.5
done

show_error "SafeBorrow did not start. Check the launch log at $LOG_FILE."
exit 1

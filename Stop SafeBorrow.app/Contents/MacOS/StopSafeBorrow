#!/bin/bash
set -u

PORT=8501
URL="http://127.0.0.1:$PORT"
PIDS="$(/usr/sbin/lsof -tiTCP:$PORT -sTCP:LISTEN 2>/dev/null || true)"

if [ -z "$PIDS" ]; then
    /usr/bin/osascript -e 'display dialog "SafeBorrow is not running." buttons {"OK"} default button "OK" with title "Stop SafeBorrow"'
    exit 0
fi

if ! /usr/bin/curl -fsS "$URL/_stcore/health" >/dev/null 2>&1; then
    /usr/bin/osascript -e 'display dialog "Port 8501 is not serving SafeBorrow, so nothing was stopped." buttons {"OK"} default button "OK" with title "Stop SafeBorrow"'
    exit 1
fi

for pid in $PIDS; do
    /bin/kill -TERM "$pid" 2>/dev/null || true
done
/usr/bin/osascript -e 'display dialog "SafeBorrow has stopped." buttons {"OK"} default button "OK" with title "Stop SafeBorrow"'
